{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "backend/**",
      "checks/**",
      "deliverables/**",
      "integration/**",
      "netlify/**",
      "pages/**",
      "public/**",
      "templates/**",
      "*.zip",
      "build-preview.py",
      "firestore.indexes.json",
      "firestore.rules",
      "LICENSE",
      "netlify.toml",
      "README.md",
      "site.json",
      "skills-lock.json",
      "verification.json"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
